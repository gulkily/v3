DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Static releases are exposed to Apache through a document-root `.static`
# symlink on hosts that permit it. Do not allow a browser to enumerate or fetch
# that storage path directly; the rules below serve only reviewed QDB routes.
RewriteCond %{THE_REQUEST} \s/+\.static(?:/|\s) [NC]
RewriteRule ^\.static(?:/|$) - [F,L]

# Only public presentation assets may bypass the PHP access gate.
RewriteCond %{REQUEST_URI} ^/(?:assets(?:/|$)|favicon\.ico)$ [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Feature and membership state must be evaluated by PHP before serving content.
# Every content, API, download, and generated-artifact request goes through the
# front controller. Public instances still use its static-artifact fast path;
# private instances always run the approved-members-only gate.
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [L]
</IfModule>
