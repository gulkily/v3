#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMAND="${1:-}"

if [[ -z "${COMMAND}" || "${COMMAND}" == "help" || "${COMMAND}" == "--help" || "${COMMAND}" == "-h" ]]; then
  cat <<'EOF'
Usage:
  ./v3 start [--listen-all|port|host:port] [--verbose|--quiet] [--log-file=/path/dev.log]
  ./v3 check-dependencies [--install|--help] (alias: dependency-check)
  ./v3 test
  ./v3 high-traffic enable|disable|status|restore|purge|refresh [/route/] [--json]
  ./v3 high-traffic cron|run [access.log] [--json]
  ./v3 status [--repository-root=/path/repository] [--database-path=/path/read-model.sqlite3] [--queue-database-path=/private/path/tasks.sqlite3] [--url=http://127.0.0.1:8000]
  ./v3 tui
  ./v3 railspike sync [--repository-root=/path/repository] [--remote-url=https://github.com/rlspk/railspike.git] [--ref=v0.2.0-beta.1]
  ./v3 fdp sync ... (deprecated alias)
  ./v3 rebuild [repository_root] [database_path]
  ./v3 rebuild diagnose [repository_root] [database_path]
  ./v3 rebuild recover --confirm [repository_root] [database_path]
  ./v3 import-instance <name|hostname|url> [--sources=/private/instances.json] [--dry-run] [--verbose] [--repository-root=/path/repository] [--database-path=/path/index.sqlite3] [--static-html-root=/path/static_html]
  ./v3 import-instance --resume [--repository-root=/path/repository] [--database-path=/path/index.sqlite3] [--static-html-root=/path/static_html]
  ./v3 images verify|restore <images.tar> <repository_root> <database_path> [--image-root=/private/images]
  ./v3 import-repository <archive.tar.gz> [repository_root] [database_path] [artifact_root] [--dry-run] [--no-commit]
  ./v3 thread-attributes <thread_id_or_record> [repository_root] [database_path]
  ./v3 delete-record <record_path_or_id> [repository_root] [database_path] [artifact_root]
  ./v3 unicode-risk-backfill [repository_root] [database_path] [--with-llm]
  ./v3 build-static [repository_root] [database_path] [artifact_root]
  ./v3 build-static --shared-only [repository_root] [database_path] [artifact_root]
  ./v3 offline publish [--repository-root=/path/repository] [--database-path=/path/read-model.sqlite3] [--static-html-root=/path/static_html]
  ./v3 offline diagnose [--url=https://public.example] [--repository-root=/path/repository] [--database-path=/path/read-model.sqlite3] [--static-html-root=/path/static_html]
  ./v3 archive-thread <thread_id> [repository_root] [database_path] [artifact_root] [archive_path]
  ./v3 private-config [view|edit|refresh-template|--view|--edit|--force|--api-key-stdin] [--path=/private/path/secrets.php]
  ./v3 openpgp smoke [--origin=zenmemes.com]
  ./v3 openpgp canary --confirm-production-write [--origin=http://zenmemes.com] [--browser-executable=/path/to/chromium] [--headed]
  ./v3 fast-score status|audit|retry|invalidate|smoke|prune [...options]
  ./v3 fast-score meta-status|meta-remove|meta-rollback|meta-retry [...options]
  ./v3 agent-reply status [post_id] [--limit=25] [--database-path=/path/post_index.sqlite3]
  ./v3 agent-reply test [--timeout=30]
  ./v3 agent-reply test-local
  ./v3 codex-handoff run [--limit=1] [--dry-run] [--database-path=/path/post_index.sqlite3] [--codex-bin=/path/codex]
  ./v3 codex-handoff test-local
  ./v3 retraction-sweep preview|status|run [--limit=250] [--repository-root=/path/repository]
  ./v3 task-queue enqueue-retraction-sweep
  ./v3 task-queue enqueue-rebuild [--queue-database-path=/private/path/tasks.sqlite3]
  ./v3 task-queue enqueue-fast-score [--queue-database-path=/private/path/tasks.sqlite3]
  ./v3 task-queue enqueue-offline-snapshot [--queue-database-path=/private/path/tasks.sqlite3]
  ./v3 task-queue reset-recovery [--queue-database-path=/private/path/tasks.sqlite3]
  ./v3 task-queue retry-agent-reply --post-id=... --content-hash=...
  ./v3 task-queue run [--task-id=N] [--limit=1] [--score-limit=25] [--work-limit=250] [--dry-run] [--quiet] [--verbose] [--error-log=/path/task_queue_errors.log]
  ./v3 task-queue status [--limit=25] [--queue-database-path=/private/path/tasks.sqlite3]
  ./v3 task-queue cron [--log=/var/log/forum-task-queue.log]
  ./v3 approve <identity_id> [seed_reason] [repository_root] [database_path]
  ./v3 approval seed <identity_id> [seed_reason] [repository_root] [database_path]
    Seed commands apply immediately on a current read model, without a full rebuild.
  ./v3 approval audit [--repository-root=/path/repository] [--database-path=/path/read-model.sqlite3] [--review-only] [--summary] [--json]
  ./v3 approval approve <approver_identity_id> <target_identity_id> [repository_root] [database_path] [artifact_root]

Terminal startup can review missing dependencies on Ubuntu 22.04/PHP 8.1 or
24.04/PHP 8.3: Enter/Y/y accepts recovery and continuation; optional intl defaults off.
Redirected startup and ordinary dependency checks never prompt or install.

Import content from another instance:
  ./v3 import-instance https://forum.example --dry-run
  ./v3 import-instance https://forum.example
  Run ./v3 import-instance --help for name aliases, options, and recovery.
EOF
  if [[ -n "${COMMAND}" ]]; then
    exit 0
  fi
  exit 1
fi

case "${COMMAND}" in
  high-traffic)
    shift
    exec php "${ROOT}/scripts/high_traffic.php" "$@"
    ;;
  retraction-sweep)
    shift
    exec php "${ROOT}/scripts/retraction_sweep.php" "$@"
    ;;
  images)
    shift
    exec php "${ROOT}/scripts/restore_images.php" "$@"
    ;;
  start)
    shift
    source "${ROOT}/scripts/local_server_dependencies.sh"
    ADDRESS_ARGUMENT="127.0.0.1:8000"
    DEV_SERVER_ARGS=()
    ADDRESS_SEEN=0
    for ARGUMENT in "$@"; do
      case "${ARGUMENT}" in
        --verbose|--quiet) DEV_SERVER_ARGS+=("${ARGUMENT}") ;;
        --log-file=) echo 'The log-file path cannot be empty.' >&2; exit 1 ;;
        --log-file=*) DEV_SERVER_ARGS+=("${ARGUMENT}") ;;
        *)
          (( ADDRESS_SEEN == 0 )) || { echo 'Specify only one listening address.' >&2; exit 1; }
          ADDRESS_ARGUMENT="${ARGUMENT}"; ADDRESS_SEEN=1 ;;

      esac
    done
    ADDRESS="${ADDRESS_ARGUMENT}"
    if [[ "${ADDRESS}" == "--listen-all" ]]; then
      ADDRESS="0.0.0.0:8000"
    elif [[ "${ADDRESS}" =~ ^:?([0-9]+)$ ]]; then
      PORT="${BASH_REMATCH[1]}"
      (( ${#PORT} <= 5 )) || { echo "Invalid port: ${PORT}" >&2; exit 1; }
      PORT_NUMBER=$((10#${PORT}))
      if (( PORT_NUMBER < 1 || PORT_NUMBER > 65535 )); then
        echo "Invalid port: ${PORT}" >&2
        exit 1
      fi
      ADDRESS="127.0.0.1:${PORT_NUMBER}"
    fi
    if [[ ! "${ADDRESS}" =~ ^([a-zA-Z0-9._-]+|\[[a-fA-F0-9:]+\]):([0-9]{1,5})$ ]]; then
      echo "Invalid listening address: ${ADDRESS}" >&2; exit 1
    fi
    PORT_NUMBER=$((10#${BASH_REMATCH[2]}))
    (( PORT_NUMBER >= 1 && PORT_NUMBER <= 65535 )) || { echo "Invalid port: ${PORT_NUMBER}" >&2; exit 1; }
    if ! local_server_dependencies_check startup; then
      [[ -t 0 && -t 1 ]] || exit 1
      local_server_dependencies_install startup || exit 1
      local_server_dependencies_check startup || exit 1
      printf '%s\n' 'Dependencies recovered; continuing the original startup request.'
    fi
    source "${ROOT}/scripts/local_server_start.sh"
    local_server_start "--address=${ADDRESS}" ${DEV_SERVER_ARGS[@]+"${DEV_SERVER_ARGS[@]}"}
    ;;
  check-dependencies|dependency-check)
    shift
    if (( $# == 1 )) && [[ "$1" == --help || "$1" == -h ]]; then
      printf '%s\n' 'Usage: ./v3 check-dependencies [--install|--help] (alias: dependency-check)' \
        'Check local-server prerequisites without starting the server or changing application state.' \
        'Required failures return 1; optional limitations are warnings.' \
        '--install: Ubuntu 22.04/PHP 8.1 or 24.04/PHP 8.3 distribution packages only; review packages, choose optional intl, and confirm in a terminal.' \
        'Confirmation precedes sudo/root execution and metadata refresh; changed transactions require new confirmation.' \
        'No unattended bypass. Failed/interrupted operations may leave partial system changes; no automatic rollback.' \
        'Installation returns 0 only for successful requested installation and required readiness, or a ready no-op.' \
        'Repair remaining configuration manually, then retry ./v3 start with the original options.' \
        'Terminal ./v3 start can offer Y/n recovery and continue once after success; optional intl defaults off.'
      exit 0
    fi
    if (( $# == 1 )) && [[ "$1" == --install ]]; then
      source "${ROOT}/scripts/local_server_dependencies.sh"
      source "${ROOT}/scripts/local_server_dependency_install.sh"
      local_server_dependencies_install
      exit $?
    fi
    if (( $# != 0 )); then
      echo 'Usage: ./v3 check-dependencies [--install|--help] (local-server prerequisites only)' >&2
      exit 1
    fi
    source "${ROOT}/scripts/local_server_dependencies.sh"
    local_server_dependencies_check report
    ;;
  test)
    shift
    php "${ROOT}/tests/run.php" "$@"
    ;;
  status)
    shift
    php "${ROOT}/scripts/status.php" "$@"
    ;;
  tui)
    shift
    exec bash "${ROOT}/scripts/terminal_operator_ui.sh" "$@"
    ;;
  railspike|fdp)
    if [[ "${COMMAND}" == fdp ]]; then
      echo 'Deprecated: use ./v3 railspike sync; FDP remains frozen.' >&2
    fi
    shift
    case "${1:-}" in
      sync)
        shift
        exec bash "${ROOT}/scripts/railspike_sync.sh" "$@"
        ;;
      -h|--help|'')
        exec bash "${ROOT}/scripts/railspike_sync.sh" --help
        ;;
      *)
        echo "Unknown ${COMMAND} command: ${1}" >&2
        exit 1
        ;;
    esac
    ;;
  rebuild)
    shift
    case "${1:-}" in
      diagnose)
        shift
        php "${ROOT}/scripts/rebuild_read_model.php" --diagnose "$@"
        ;;
      recover)
        shift
        php "${ROOT}/scripts/rebuild_read_model.php" --recover-sidecars "$@"
        ;;
      *)
        php "${ROOT}/scripts/rebuild_read_model.php" "$@"
        ;;
    esac
    ;;
  import-instance)
    shift
    php "${ROOT}/scripts/import_instance.php" "$@"
    ;;
  import-repository)
    shift
    php "${ROOT}/scripts/import_repository_archive.php" "$@"
    ;;
  thread-attributes)
    shift
    php "${ROOT}/scripts/thread_attributes.php" "$@"
    ;;
  delete-record)
    shift
    php "${ROOT}/scripts/delete_record.php" "$@"
    ;;
  unicode-risk-backfill)
    shift
    php "${ROOT}/scripts/backfill_unicode_risk.php" "$@"
    ;;
  build-static)
    shift
    case "${1:-}" in
      --help|-h)
        cat <<'EOF'
Usage:
  ./v3 build-static [repository_root] [database_path] [artifact_root]
  ./v3 build-static --shared-only [repository_root] [database_path] [artifact_root]

The default command rebuilds the read model and all static pages.
--shared-only copies the active release and refreshes shared pages and assets
without rebuilding data or rendering tag, thread, post, or profile pages.
EOF
        ;;
      --shared-only)
        shift
        if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
          cat <<'EOF'
Usage: ./v3 build-static --shared-only [repository_root] [database_path] [artifact_root]

Requires an active complete static release. It copies that release, refreshes
shared pages and assets, and atomically activates the result.
EOF
        else
          php "${ROOT}/scripts/refresh_static_shared_artifacts.php" "$@"
        fi
        ;;
      --*)
        echo "Unknown build-static option: ${1}" >&2
        echo "Run ./v3 build-static --help for usage." >&2
        exit 1
        ;;
      *)
        php "${ROOT}/scripts/build_static_artifacts.php" "$@"
        ;;
    esac
    ;;
  offline)
    shift
    SUBCOMMAND="${1:-}"
    case "${SUBCOMMAND}" in
      publish)
        shift
        php "${ROOT}/scripts/publish_offline_snapshot.php" "$@"
        ;;
      diagnose)
        shift
        php "${ROOT}/scripts/diagnose_offline_reading.php" "$@"
        ;;
      *)
        echo "Usage: ./v3 offline {publish|diagnose} [options]" >&2
        exit 1
        ;;
    esac
    ;;
  archive-thread)
    shift
    php "${ROOT}/scripts/archive_thread.php" "$@"
    ;;
  private-config)
    shift
    php "${ROOT}/scripts/write_private_config.php" "$@"
    ;;
  openpgp)
    shift
    SUBCOMMAND="${1:-}"
    case "${SUBCOMMAND}" in
      smoke)
        shift
        php "${ROOT}/scripts/openpgp_smoke.php" "$@"
        ;;
      canary)
        shift
        node "${ROOT}/scripts/openpgp_production_canary.mjs" "$@"
        ;;
      *)
        echo "Usage:" >&2
        echo "  ./v3 openpgp smoke [--origin=zenmemes.com]" >&2
        echo "  ./v3 openpgp canary --confirm-production-write [--origin=http://zenmemes.com] [--browser-executable=/path/to/chromium] [--headed]" >&2
        exit 1
        ;;
    esac
    ;;
  fast-score)
    shift
    php "${ROOT}/scripts/fast_score.php" "$@"
    ;;
  agent-reply)
    shift
    SUBCOMMAND="${1:-}"
    case "${SUBCOMMAND}" in
      status)
        shift
        php "${ROOT}/scripts/agent_reply_status.php" "$@"
        ;;
      test)
        shift
        php "${ROOT}/scripts/test_agent_reply_provider.php" "$@"
        ;;
      test-local)
        shift
        php "${ROOT}/tests/run.php" \
          AgentReplyGenerationTest \
          AgentReplyCommandTest \
          LocalAppSmokeTest::testAgentReplyStatusCommandShowsSkippedReasonAndAnalysisFailure \
          WriteApiSmokeTest::testTaskQueueProcessesQueuedAgentReplyOnce \
          "$@"
        ;;
      *)
        echo "Usage:" >&2
        echo "  ./v3 agent-reply status [post_id] [--limit=25] [--database-path=/path/post_index.sqlite3]" >&2
        echo "  ./v3 agent-reply test [--timeout=30]" >&2
        echo "  ./v3 agent-reply test-local" >&2
        exit 1
        ;;
    esac
    ;;
  codex-handoff)
    shift
    SUBCOMMAND="${1:-}"
    case "${SUBCOMMAND}" in
      run)
        shift
        php "${ROOT}/scripts/run_codex_handoffs.php" "$@"
        ;;
      test-local)
        shift
        php "${ROOT}/tests/run.php" \
          CodexHandoffDraftServiceTest \
          CodexHandoffStoreTest \
          CodexHandoffRunnerTest \
          WriteApiSmokeTest::testCodexHandoffApiRequiresApprovedLocalhostAndPreparesDraft \
          WriteApiSmokeTest::testCodexHandoffApiRejectsNonLocalhostAndSupportsRejectDecision \
          WriteApiSmokeTest::testCodexHandoffRequiresDevelopmentTagOrThreadLabelInApiAndUi \
          WriteApiSmokeTest::testCodexHandoffAllowsDevelopmentThreadLabelsOnRootPost \
          WriteApiSmokeTest::testCodexHandoffReplyAddedThreadLabelShowsRootButtonOnly \
          WriteApiSmokeTest::testCodexHandoffLifecycleAppearsInActivityAndSurvivesRebuild \
          WriteApiSmokeTest::testApprovedLocalhostViewerSeesCodexHandoffButtonAndPreviewAfterDraft \
          WriteApiSmokeTest::testPostAnalysisScriptBindsCodexHandoffActions \
          "$@"
        ;;
      *)
        echo "Usage:" >&2
        echo "  ./v3 codex-handoff run [--limit=1] [--dry-run] [--database-path=/path/post_index.sqlite3] [--codex-bin=/path/codex]" >&2
        echo "  ./v3 codex-handoff test-local" >&2
        exit 1
        ;;
    esac
    ;;
  task-queue)
    shift
    php "${ROOT}/scripts/task_queue.php" "$@"
    ;;
  approval)
    shift
    if [[ "${1:-}" == "audit" ]]; then
      shift
      php "${ROOT}/scripts/audit_approvals.php" "$@"
    else
      php "${ROOT}/scripts/inject_approval.php" "$@"
    fi
    ;;
  approve)
    shift
    php "${ROOT}/scripts/inject_approval.php" seed "$@"
    ;;
  *)
    echo "Unknown command: ${COMMAND}" >&2
    echo "Run ./v3 with no arguments to see available commands." >&2
    exit 1
    ;;
esac
