<?php

declare(strict_types=1);

// Private runtime config for this forum instance.
// This file may contain secrets. Keep it outside public/ and out of git.
// Run ./v3 private-config view to inspect redacted effective values.
// Run ./v3 private-config refresh-template to refresh comments/examples without changing values.

return [
    // LLM provider used for post analysis and agent reply drafting.
    // Supported values: dedalus, openai, openrouter, anthropic, stub, or a custom OpenAI-compatible gateway name.
    'LLM_PROVIDER' => 'dedalus',

    // Provider API key. For LLM_PROVIDER=stub this can stay as the placeholder.
    'LLM_API_KEY' => 'replace-with-real-key',

    // Base URL without the endpoint path.
    // OpenAI-compatible providers call /v1/chat/completions; Anthropic calls /v1/messages.
    'LLM_API_BASE_URL' => 'https://api.dedaluslabs.ai',

    // Provider model identifier.
    'LLM_MODEL' => 'openai/gpt-5-nano',

    // External provider request timeout in seconds.
    'LLM_TIMEOUT_SECONDS' => 60,

    // Optional provider headers. OpenRouter commonly uses HTTP-Referer and X-Title.
    'LLM_EXTRA_HEADERS' => [],

    // Prompt template path, relative to the application root unless absolute.
    'LLM_POST_ANALYSIS_PROMPT_PATH' => 'prompts/dedalus_post_analysis_system.txt',

    // Agent reply controls. These names remain Dedalus-prefixed for backward compatibility.
    'DEDALUS_AGENT_REPLIES_ENABLED' => true,
    'DEDALUS_AGENT_REPLIES_AUTOMATIC_ENABLED' => false,

    // Private LLM exchange capture and web visibility. Both default to true.
    'LLM_CONVERSATION_RECORDING_ENABLED' => true,
    'LLM_CONVERSATION_UI_ENABLED' => true,
    // Optional; defaults to state/private/llm_exchanges.sqlite3.
    // 'LLM_EXCHANGE_DATABASE_PATH' => '/srv/forum-rewrite/state/private/llm_exchanges.sqlite3',
];

