# Production environment example

FORUM_REPOSITORY_ROOT=/srv/forum-rewrite/repository
FORUM_DATABASE_PATH=/srv/forum-rewrite/state/cache/post_index.sqlite3
LLM_EXCHANGE_DATABASE_PATH=/srv/forum-rewrite/state/private/llm_exchanges.sqlite3
FORUM_PUBLIC_ARTIFACT_ROOT=/srv/forum-rewrite/app/public

# Optional: selects which SiteProfileRegistry entry (name, default theme,
# composer copy) this deployment renders. Defaults to zenmemes when unset.
# FORUM_SITE_ID=zenmemes

# Optional alternate static root for non-sibling artifact layouts.
# FORUM_STATIC_HTML_ROOT=/srv/forum-rewrite/state/static_html

# Optional operator override: allow visible UTF-8 prose in authored post subject/body.
# Defaults to disabled when absent and no site-content flag is set.
# FORUM_UNICODE_AUTHORED_TEXT=false

# Optional operator override: show browser-side app version polling and reload banner.
# Defaults to enabled when absent and no site-content flag is set.
# FORUM_APP_VERSION_NOTIFICATION=true

# Optional cron entry for queued agent reply request fulfillment.
# * * * * * cd /srv/forum-rewrite/app && php scripts/run_agent_reply_requests.php --quiet --limit=10 >> /var/log/forum-agent-replies.log 2>&1

# Normal site-level flag changes should use /tools/feature-flags/ so
# records/instance/feature-flags.txt is committed to the content repository.

# Optional private config file for shared-hosting secrets.
# FORUM_SECRETS_PATH=/srv/forum-rewrite-private/secrets.php
